#!/usr/bin/env bash

user="vss"

color_array=(
    "$(tput setaf 160)"
    "$(tput setaf 209)"
    "$(tput setaf  11)"
    "$(tput setaf  34)"
    "$(tput setaf  33)"
)

sparkle_array=(
    "*"
    "+"
    "x"
    "."
)

mesg=(
    "Happy Diwali from $user!"
    "May this Diwali bring light"
    "and joy into your life!"
)

FLOWER_POT_YELLOW=$(tput setaf 226)
MESG_COLOR=$(tput setaf 15)
RESET=$(tput sgr0)

cleanup () {
    tput rmcup
    tput cnorm
}

trap cleanup exit

tput smcup
tput civis

IFS= read -r -d '' FLOWER_POT <<- "EOF"
             4 --- 2   3   2 --- 4 
      1     /       \  |  /       \     4 
           1         1 | 1         1 
               0      \|/      2 
                       1          1     3 
        4              |      1 
             3 --- 2   3   2 --- 3 
      0     /       \  |  /       \
           4         1 | 1   2     4 
                      \|/
                       1 
            3          |          4 
                       0 
                      /_\
                     /   \
                    /     \
                   /_______\
                  /_________\
EOF
OBJ_HEIGHT=18
OBJ_WIDTH=42

idx=0
color_array_len=${#color_array[@]}
sparkle_array_len=${#sparkle_array[@]}
cols=$(tput cols)
lines=$(tput lines)

middle_y=$(((lines / 2) - (OBJ_HEIGHT / 2)))

while true; do
    flowerpot=$FLOWER_POT

    color_index=$RANDOM
    sparkle_index=$RANDOM

    for n in {0..4}; do
        color="${color_array[(color_index + n) % color_array_len]}"
        sparkle="${sparkle_array[(sparkle_index + n) % sparkle_array_len]}"

        flowerpot=${flowerpot// $n / $color$sparkle$FLOWER_POT_YELLOW }
    done
    
    tput cup $middle_y 0
    printf '%s\n' "$flowerpot"

    mesg_y=$((middle_y + 9))
    mesg_x=$((OBJ_WIDTH + 5))
    for line in "${mesg[@]}"; do
        tput cup "$mesg_y" "$mesg_x"
        echo "$MESG_COLOR$line$FLOWER_POT_YELLOW"
        ((mesg_y++))
    done
    sleep 1
done

exit 0

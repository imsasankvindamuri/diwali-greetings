#!/usr/bin/env bash
#
# Animated Diwali flowerpot (chicchu buddi) greeting.

NAME="V Sai Sasank"

COLORS=(
    "$(tput setaf 160)"
    "$(tput setaf 209)"
    "$(tput setaf 11)"
    "$(tput setaf 34)"
    "$(tput setaf 33)"
)

SPARKLES=("*" "+" "x" ".")

MESSAGE=(
    "Happy Diwali from $NAME!"
    "May this Diwali bring light"
    "and joy into your life!"
)

POT_COLOR=$(tput setaf 226)
MESG_COLOR=$(tput setaf 15)

# Digits 0-4 are sparkle placeholders. A digit is only replaced when it has a
# space on both sides, so the trailing spaces on some lines are intentional.

IFS= read -r -d '' FLOWER_POT <<- 'EOF'
             4 --- 2   3   2 --- 4 
      1     /       \  |  /       \     4 
           1         1 | 1         1 
               0      \|/      2 
                       1          1     3 
        4              |      1 
             3 --- 2   3   2 --- 3 
      0     /       \  |  /       \
           4         1 | 1   2     4 
                      \|/
                       1 
            3          |          4 
                       0 
                      /_\
                     /   \
                    /     \
                   /_______\
                  /_________\
EOF
OBJ_HEIGHT=18
OBJ_WIDTH=42

num_colors=${#COLORS[@]}
num_sparkles=${#SPARKLES[@]}

top=$(( $(tput lines) / 2 - OBJ_HEIGHT / 2 ))
mesg_top=$((top + 9))
mesg_left=$((OBJ_WIDTH + 5))

cleanup() {
    tput rmcup
    tput cnorm
}
trap cleanup EXIT

tput smcup
tput civis

while true; do
    frame=$FLOWER_POT
    color_offset=$RANDOM
    sparkle_offset=$RANDOM

    for n in {0..4}; do
        color=${COLORS[(color_offset + n) % num_colors]}
        sparkle=${SPARKLES[(sparkle_offset + n) % num_sparkles]}
        frame=${frame// $n / $color$sparkle$POT_COLOR }
    done

    tput cup "$top" 0
    printf '%s\n' "$frame"

    y=$mesg_top
    for line in "${MESSAGE[@]}"; do
        tput cup "$y" "$mesg_left"
        printf '%s\n' "$MESG_COLOR$line$POT_COLOR"
        ((y++))
    done

    sleep 1
done
